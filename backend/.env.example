# ── SERVER ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── DATABASE (from Railway PostgreSQL service) ────────────────
DB_HOST=your-railway-postgres-host
DB_PORT=5432
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=your-railway-postgres-password

# ── AUTH ──────────────────────────────────────────────────────
JWT_SECRET=generate-a-random-64-char-string-here
JWT_EXPIRES_IN=7d

# ── UPLOADS (Railway Volume must be mounted at /app/uploads) ──
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10
PUBLIC_URL=https://api.carronahora.com

# ── CORS (all frontend origins, comma separated) ──────────────
CORS_ORIGIN=https://carronahora.com,https://www.carronahora.com,https://admin.carronahora.com

# ── ADMIN CREDENTIALS (first deploy only) ────────────────────
ADMIN_EMAIL=perimetrodeeficacia@gmail.com
ADMIN_PASSWORD=your-secure-password-here

# ── EMAIL ─────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
RESEND_TO_EMAIL=perimetrodeeficacia@gmail.com
